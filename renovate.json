{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "requirements.txt is uv export of uv.lock, remade by the post-upgrade task below: never edit it alone, or CI fails its lock check",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements.txt"],
      "enabled": false
    }
  ],
  "postUpgradeTasks": {
    "commands": ["uv export --frozen --no-dev --no-emit-project --no-hashes -o requirements.txt"],
    "fileFilters": ["requirements.txt"],
    "executionMode": "branch",
    "installTools": {
      "uv": {}
    }
  }
}
