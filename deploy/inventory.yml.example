---
all:
  hosts:
    nova_hub:
      ansible_host: your-server.example.com
      ansible_user: root  # or a sudo-capable user
      # ansible_ssh_private_key_file: ~/.ssh/id_ed25519

      # Required:
      nova_hub_domain: hub.example.com  # domain for TLS certificate

      # Override defaults if needed:
      # nova_hub_user: novahub        # dedicated service user (created automatically)
      # nova_hub_dir: /home/novahub/nova-hub
      # nova_data_dir: /home/novahub/nova-data
      # nova_hub_version: v0.12.0    # tag, branch or commit; production runs tags
      # nova_hub_manage_caddy: false  # where the fleet's caddy role owns /etc/caddy
      # nova_hub_manage_dosemu: false # where the fleet's dosemu role pins dosemu2
